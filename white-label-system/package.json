{
  "name": "barbershop-white-label",
  "version": "1.0.0",
  "description": "White-label SaaS platform for barbershop agencies and chains",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node server/index.js",
    "client:dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "echo 'Server ready'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prisma": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "stripe": "^12.0.0",
    "nodemailer": "^6.9.4",
    "express-rate-limit": "^6.10.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.4.3",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.4",
    "supertest": "^6.3.3",
    "@babel/core": "^7.22.20",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "babel-jest": "^29.7.0",
    "eslint": "^8.49.0",
    "eslint-plugin-react": "^7.32.2",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "vite": "^4.4.9",
    "@vitejs/plugin-react": "^4.0.3"
  }
}
