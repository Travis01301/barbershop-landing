{
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "env": {
    "NODE_ENV": "production"
  },
  "nodeVersion": "20.x",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backup-cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/test-restore",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/backup-statistics",
      "schedule": "0 5 * * *"
    }
  ]
}
